# ---------------------------------------------------------------------------
# Razorpay Settlement Reconciliation Agent -- environment template
# Copy to `.env` and fill in.  NEVER commit a real `.env`.
# ---------------------------------------------------------------------------

ENVIRONMENT=local
DEBUG=true

# Comma-separated origins allowed to call the API (the Lovable/Next.js app).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# SQLite for local dev. For Postgres:
#   DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/recon
DATABASE_URL=sqlite:///./data/recon.db
SQL_ECHO=false

# Where uploaded CSVs are written. Swap for an object store later.
UPLOAD_STORAGE_PATH=./data/uploads
MAX_UPLOAD_BYTES=536870912

# Reconciliation engine tuning
BATCH_SIZE=10000
ROUNDING_TOLERANCE_MINOR=100
DEFAULT_CURRENCY=INR

# ---------------------------------------------------------------------------
# LLM -- classification/explanation only. Never used for arithmetic.
# LLM_PROVIDER: null | anthropic | openai | gemini
#   `null` runs a deterministic rule-based explainer, so the whole system works
#   end-to-end with no API key and no network.
#   `gemini` uses Google's Generative Language API -- get a free key at
#   https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
LLM_PROVIDER=null
LLM_API_KEY=
MODEL_NAME=gemini-3.5-flash-lite
# For LLM_PROVIDER=anthropic/openai, set MODEL_NAME to that provider's model id
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
AI_ENABLED=true
AI_MAX_EXCEPTIONS_PER_JOB=500
AI_BATCH_SIZE=20
